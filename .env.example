# Copie para .env.local (nunca faça commit de .env.local).

# ─── Fonte de dados ──────────────────────────────────────────────────
# "supabase" (produção) ou "local" (arquivos em .storage/, só desenvolvimento).
# Vazio = usa Supabase quando SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY existirem.
DATA_PROVIDER=supabase

# ─── Supabase (Project Settings > API Keys) ─────────────────────────
# Use a chave PUBLICÁVEL (publishable/anon). NUNCA coloque a service_role/secret aqui:
# a segurança das escritas é garantida pelo login + Row Level Security.
SUPABASE_URL=https://wuukckiepoqxauwfhmwy.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ─── Modo local (somente DATA_PROVIDER=local) ───────────────────────
# Login do painel e segredo que assina o cookie de sessão.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=
# LOCAL_STORAGE_DIR=.storage
